FROM node:24-alpine AS build

RUN npm i -g pnpm

WORKDIR /usr/src/app

COPY ./package.json ./pnpm-lock.yaml ./pnpm-workspace.yaml ./

COPY ./apps/pubSub-worker/package.json ./worker/
COPY ./packages ./packages/

COPY ./turbo.json ./turbo.json

RUN pnpm install

COPY ./apps/pubSub-worker ./worker/

RUN cd worker && pnpm install && pnpm add  -D @types/node && pnpm run build


FROM node:24-alpine AS prod

COPY --from=build usr/src/app/worker/dist .
COPY --from=build usr/src/app/worker/package.json ./
COPY --from=build usr/src/app/packages ./packages/
COPY --from=build usr/src/app/pnpm-lock.yaml ./
COPY --from=build usr/src/app/pnpm-workspace.yaml ./
RUN npm i -g pnpm

RUN pnpm install

CMD [ "node", "index.js" ]
